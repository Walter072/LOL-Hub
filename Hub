local toggleBtn = Instance.new("TextButton")
toggleBtn.Name = "ToggleBtn"
toggleBtn.Size = UDim2.fromOffset(52, 52)
toggleBtn.Position = UDim2.new(1, -68, 1, -68)
toggleBtn.BackgroundColor3 = C.accent
toggleBtn.BackgroundTransparency = 0.1
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 13
toggleBtn.TextColor3 = C.text
toggleBtn.Text = "LOL"
toggleBtn.Visible = false
toggleBtn.Parent = gui
corner(toggleBtn, 10)
stroke(toggleBtn, C.stroke, 2, 0.2)

do
    local dragging, dragStart, startPos, moved
    toggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = toggleBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            if d.Magnitude > 6 then moved = true end
            toggleBtn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
    toggleBtn.MouseButton1Click:Connect(function()
        if moved then return end -- fue drag, no click
        if getgenv().__LOL_ToggleHub then
            getgenv().__LOL_ToggleHub()
        end
    end)
end

