local function openStudio(props)
    if not getgenv().LOL_StudioEditor then
        warn("[LOL] Studio editor desactivado en Settings")
        return
    end
    clearStudio()
    studioTitle.Text = "Properties"
    for _, p in ipairs(props) do
        studioRow(p.name, p.value, function(text)
            local n = tonumber(text)
            if n ~= nil and p.apply then
                p.apply(n)
                p.value = n
            elseif p.apply and n == nil then
                p.apply(text)
                p.value = text
            end
        end)
    end
    studio.Visible = true
end

